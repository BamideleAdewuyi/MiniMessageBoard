<html>
    <body>
        <h1><%= title %></h1>
        <a href="/new">Write new message</a>
        <div class="messages">
            <% for (const message of messages) { %>
                <div class="message">
                    <p>Message: <%= message.text %></p>
                    <p>From: <%= message.user %></p>
                    <p>Sent: <%= message.added %></p>
                </div> 
                <a href="details/<%= message.id %>">OPEN</a>
            <% } %>
        </div>
    </body>
</html>