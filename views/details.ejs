<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <div class="message">
        <h1>Message Details</h1>
        <p>Message: <%= message.text %></p>
        <p>From: <%= message.name %></p>
        <p>Sent: <%= message.added %></p>
        <p>ID: <%= message.id %></p>
    </div>
</body>
</html>